@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Şifre Sıfırlama Onayı";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow-lg border-success">
            <div class="card-header bg-success text-white text-center">
                <h2 class="mb-0">✅ @ViewData["Title"]</h2>
            </div>
            <div class="card-body text-center">
                <p class="lead mt-3">
                    Şifrenizi sıfırlamak için lütfen **e-posta kutunuzu kontrol edin**.
                </p>
                <p class="text-muted">
                    E-posta kutunuza sıfırlama bağlantısı gönderilmiştir. Gelen kutusunda bulamazsanız, lütfen Spam/Gereksiz klasörünü de kontrol ediniz.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3">Anasayfaya Dön</a>
            </div>
        </div>
    </div>
</div>