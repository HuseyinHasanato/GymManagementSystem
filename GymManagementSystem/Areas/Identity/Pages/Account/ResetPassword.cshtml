@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Şifre Yenileme";
}

<h2 class="text-center mb-4 text-success">🔑 @ViewData["Title"]</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <h4 class="text-center mb-3">Yeni şifrenizi belirleyin.</h4>
        <hr />

        <div class="card shadow-sm p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                {{-- Gizli Kod Alanı: E-posta ile gelen sıfırlama kodu burada tutulur --}}
                <input asp-for="Input.Code" type="hidden" />

                {{-- Alan: E-posta --}}
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="E-posta" />
                    <label asp-for="Input.Email" class="form-label">E-posta Adresi</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                {{-- Alan: Yeni Şifre --}}
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Yeni şifre" />
                    <label asp-for="Input.Password" class="form-label">Yeni Şifre</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                {{-- Alan: Şifre Onayı --}}
                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Şifreyi onaylayın" />
                    <label asp-for="Input.ConfirmPassword" class="form-label">Yeni Şifre Onayı</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="w-100 btn btn-lg btn-success">
                        <i class="fas fa-key"></i> Şifreyi Yenile
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}