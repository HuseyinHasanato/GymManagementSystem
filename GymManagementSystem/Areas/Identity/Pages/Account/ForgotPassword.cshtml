@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Şifrenizi mi Unuttunuz?";
}

<h2 class="text-center mb-4 text-warning">🔒 @ViewData["Title"]</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <h4 class="text-center mb-3">Hesabınıza erişimi yeniden kazanmak için e-posta adresinizi girin.</h4>
        <hr />

        <div class="card shadow-sm p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                {{-- Alan: E-posta --}}
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="adiniz@example.com" />
                    <label asp-for="Input.Email" class="form-label">E-posta Adresi</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="w-100 btn btn-lg btn-warning text-white">
                        <i class="fas fa-redo"></i> Şifre Sıfırlama Bağlantısı Gönder
                    </button>
                    <a asp-page="./Login" class="w-100 btn btn-sm btn-secondary mt-2">Giriş Sayfasına Geri Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}