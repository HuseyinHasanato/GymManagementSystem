@page
@model RegisterModel
@{
    ViewData["Title"] = "Yeni Hesap Oluştur";
}

<h2 class="text-center mb-4 text-primary">✍️ @ViewData["Title"]</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h4 class="mb-3">Devam etmek için bir hesap oluşturun.</h4>
            <hr />

            {{-- Hata Özeti --}}
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 border p-3" role="alert"></div>

            {{-- Alan: E-posta --}}
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="adiniz@example.com" />
                <label asp-for="Input.Email">E-posta Adresi</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            {{-- Alan: Şifre --}}
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="şifre" />
                <label asp-for="Input.Password">Şifre</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            {{-- Alan: Şifre Tekrarı --}}
            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="şifre tekrar" />
                <label asp-for="Input.ConfirmPassword">Şifreyi Onayla</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2">
                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">
                    <i class="fas fa-user-plus"></i> Hesap Oluştur
                </button>
                <a asp-page="./Login" class="w-100 btn btn-lg btn-secondary mt-2">Zaten hesabım var (Giriş Yap)</a>
            </div>

        </form>
    </div>

    <div class="col-md-6 mt-4 mt-md-0">
        <section>
            <h4 class="text-center text-muted">Harici Kayıt Servisleri</h4>
            <hr />
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div class="alert alert-info text-center">
                        <p>
                            Şu anda harici kimlik doğrulama servisleri (Google, Facebook vb.) yapılandırılmamıştır.
                            Yalnızca yerel hesap oluşturma kullanılabilir.
                        </p>
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            <p>
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-outline-primary m-1" name="provider" value="@provider.Name" title="@provider.DisplayName hesabınızı kullanarak giriş yapın">
                                        <i class="fab fa-@provider.Name.ToLower()"></i> @provider.DisplayName ile Kayıt Ol
                                    </button>
                                }
                            </p>
                        </div>
                    </form>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}