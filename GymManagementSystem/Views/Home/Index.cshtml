@{
    ViewData["Title"] = "الصفحة الرئيسية";
}

<div class="text-center py-5" style="background-color: #f8f9fa;">
    <h1 class="display-3" style="color: #4B0082; font-weight: bold;">أهلاً بك في نظام إدارة الصالة الرياضية</h1>
    <p class="lead mt-4">
        نظامك المتكامل لإدارة المواعيد، الخدمات، المدربين، والحصول على خطط تمرين شخصية مدعومة بالذكاء الاصطناعي.
    </p>

    <div class="mt-5">
        <a asp-controller="GroupClasses" asp-action="Index" class="btn btn-primary btn-lg mx-2">استعراض الخدمات</a>

        @if (User.Identity.IsAuthenticated)
        {
            <a asp-controller="AI" asp-action="Profile" class="btn btn-success btn-lg mx-2">
                <i class="fas fa-robot"></i> خطة الذكاء الاصطناعي
            </a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary btn-lg mx-2">
                تسجيل الدخول / البدء
            </a>
        }
    </div>
</div>