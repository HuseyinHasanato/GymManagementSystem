@model GymManagementSystem.Models.UserProfile
@{
    ViewData["Title"] = "AI Antrenman Planı";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0 h4"><i class="bi bi-cpu-fill text-info"></i> AI Antrenman Asistanı</h3>
        </div>

        <div class="card-body p-4">
            @if (ViewBag.WorkoutPlan != null)
            {
                <div class="p-4 bg-white border rounded shadow-sm">
                    <h5 class="text-primary border-bottom pb-2 mb-4">Size Özel Program</h5>

                    @* تعديل أساسي: تحويل النص القادم من AI ليدعم الأسطر الجديدة *@
                    <div class="ai-content" style="white-space: pre-line; font-family: sans-serif; line-height: 1.6;">
                        @Html.Raw(ViewBag.WorkoutPlan.ToString())
                    </div>
                </div>

                <div class="mt-4 text-center no-print">
                    <button onclick="window.print()" class="btn btn-primary rounded-pill">Yazdır / PDF</button>
                    <a asp-action="Profile" class="btn btn-outline-secondary rounded-pill">Yeniden Oluştur</a>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <h4 class="mt-4">Planınız Hazırlanıyor...</h4>
                    <p>Lütfen bekleyin, Gemini AI programınızı oluşturuyor.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        /* هذا التنسيق هو ما سيجعل النص يظهر كجدول مرتب */
        .ai-simple-content {
            white-space: pre-wrap; /* يحافظ على الأسطر الجديدة */
            word-wrap: break-word;
            font-family: 'Courier New', Courier, monospace; /* خط ثابت العرض لجعل الجداول متناسقة */
            background-color: #f8f9fa;
            padding: 20px;
            border-left: 5px solid #0d6efd;
            font-size: 1rem;
            line-height: 1.5;
            color: #333;
        }

        @@media print {
            .no-print {
                display: none !important;
            }
        }
    </style>
}