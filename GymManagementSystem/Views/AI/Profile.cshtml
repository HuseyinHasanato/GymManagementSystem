@model GymManagementSystem.Models.UserProfile
@{
    ViewData["Title"] = "Kullanıcı Profili ve Yapay Zeka Önerileri";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center py-3">
                    <h2 class="mb-0"><i class="bi bi-person-gear"></i> Yapay Zeka Girişleri</h2>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">
                        Kişisel bir egzersiz planı almak için lütfen vücut ölçülerinizi ve hedefinizi girin.
                    </p>

                    @* تم التعديل هنا: تحديد الـ Controller والـ Action بوضوح *@
                    <form asp-action="SaveProfile" asp-controller="AI" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />
                        @* تأكد من إرسال الـ MemberId إذا كان موجوداً لمنع أخطاء الـ Validation *@
                        <input type="hidden" asp-for="MemberId" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="HeightCm" class="form-label fw-bold">Boy (cm)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-arrows-vertical"></i></span>
                                    <input asp-for="HeightCm" class="form-control" type="number" placeholder="Örn: 175" required />
                                </div>
                                <span asp-validation-for="HeightCm" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="WeightKg" class="form-label fw-bold">Kilo (kg)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-speedometer2"></i></span>
                                    <input asp-for="WeightKg" class="form-control" type="number" step="0.1" placeholder="Örn: 70.5" required />
                                </div>
                                <span asp-validation-for="WeightKg" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Age" class="form-label fw-bold">Yaş</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="Age" class="form-control" type="number" placeholder="Örn: 25" required />
                                </div>
                                <span asp-validation-for="Age" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="FitnessGoal" class="form-label fw-bold">Fitness Hedefi</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-target"></i></span>
                                    <select asp-for="FitnessGoal" class="form-select" required>
                                        <option value="">-- Hedefinizi Seçin --</option>
                                        <option value="Kas Kazanımı (Muscle Gain)">Kas Kazanımı</option>
                                        <option value="Kilo Kaybı (Weight Loss)">Kilo Kaybı</option>
                                        <option value="Dayanıklılık ve Genel Fitness (Endurance)">Dayanıklılık ve Genel Fitness</option>
                                    </select>
                                </div>
                                <span asp-validation-for="FitnessGoal" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr />

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill shadow">
                                <i class="bi bi-magic"></i> Verileri Kaydet ve Plan Al
                            </button>
                            <a asp-action="Index" asp-controller="Home" class="btn btn-link text-secondary">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}