@model IEnumerable<GymManagementSystem.Models.ClassEnrollment>

@{
    ViewData["Title"] = "Aktif Kayıtlarım";
}

<h1>Aktif Ders Kayıtlarım</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                Ders Adı
            </th>
            <th>
                Başlangıç Saati
            </th>
            <th>
                Eğitmen
            </th>
            <th>
                İşlem
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.GroupClass!.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GroupClass!.StartTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GroupClass!.Trainer!.FullName)
                </td>
                <td>
                    <form asp-action="Cancel" asp-route-classId="@item.GroupClassId" method="post">
                        <input type="hidden" name="classId" value="@item.GroupClassId" />
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bu kaydı iptal etmek istediğinizden emin misiniz?');">
                            Kaydı İptal Et
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="lead mt-4">Henüz aktif bir ders kaydınız bulunmamaktadır.</p>
    <a href="@Url.Action("Index", "GroupClasses")" class="btn btn-info">Tüm Derslere Göz At</a>
}