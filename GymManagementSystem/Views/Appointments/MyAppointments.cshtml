@model IEnumerable<GymManagementSystem.Models.Appointment>
@{
    ViewData["Title"] = "Randevularım";
}

<h2 class="text-center mb-4">🗓️ Randevularım</h2>
<p class="text-center text-muted">Mevcut ve geçmiş randevularınızın durumunu buradan takip edebilirsiniz.</p>

<div class="mb-3">
    <a asp-action="Book" class="btn btn-success"><i class="fas fa-calendar-plus"></i> Yeni Randevu Al</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info text-center mt-5">
        Şu anda kayıtlı randevunuz bulunmamaktadır. Hemen yeni bir randevu alabilirsiniz!
    </div>
}
else
{
    <table class="table table-striped table-hover mt-4">
        <thead class="bg-primary text-white">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Class)</th>
                <th>@Html.DisplayNameFor(model => model.StartTime)</th>
                <th>@Html.DisplayNameFor(model => model.EndTime)</th>
                <th>@Html.DisplayNameFor(model => model.IsConfirmed)</th>
                <th>@Html.DisplayNameFor(model => model.Notes)</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var rowClass = item.IsConfirmed ? "table-success" : "table-warning";

                <tr class="@rowClass">
                    <td>@(item.Class?.Name ?? "Bilinmiyor")</td>
                    <td>@item.StartTime.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@item.EndTime.ToString("HH:mm")</td>
                    <td>
                        @if (item.IsConfirmed)
                        {
                            <span class="badge bg-success">Onaylandı</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Onay Bekliyor</span>
                        }
                    </td>
                    <td>@(string.IsNullOrEmpty(item.Notes) ? "Yok" : item.Notes)</td>
                    <td>
                        @* İptal Butonu sadece gelecekteki ve onaylanmamış randevular için gösterilebilir. *@
                        @if (item.StartTime > DateTime.Now && !item.IsConfirmed)
                        {
                            <form asp-action="Reject" asp-route-id="@item.AppointmentId" method="post" onsubmit="return confirm('Bu randevuyu iptal etmek istediğinizden emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-danger">İptal Et</button>
                            </form>
                        }
                        else if (item.StartTime > DateTime.Now && item.IsConfirmed)
                        {
                            <span class="text-info">Onaylanmış Randevu</span>
                        }
                        else
                        {
                            <span class="text-muted">Geçmiş Randevu</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}