@model GymManagementSystem.Models.Appointment
@{
    ViewData["Title"] = "Randevu Al";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0"><i class="bi bi-calendar-plus"></i> Yeni Randevu Oluştur</h3>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">Lütfen ders seçiminizi yapın. Bitiş saati otomatik hesaplanacaktır.</p>

                    <form asp-action="Book" method="post">
                        @* إظهار جميع الأخطاء هنا لمعرفة سبب الفشل *@
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        @* حقل مخفي لوقت النهاية لتجاوز فحص الـ Validation في المتصفح *@
                        <input type="hidden" asp-for="EndTime" value="@DateTime.Now.AddHours(1)" />

                        @* 1. اختيار الحصة *@
                        <div class="form-group mb-3">
                            <label asp-for="GroupClassId" class="form-label fw-bold">Ders / Hizmet Seçin</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-gym"></i></span>
                                <select asp-for="GroupClassId" class="form-select" asp-items="ViewBag.GroupClassId">
                                    <option value="">-- Lütfen bir ders seçiniz --</option>
                                </select>
                            </div>
                            <span asp-validation-for="GroupClassId" class="text-danger small"></span>
                        </div>

                        @* 2. وقت البدء *@
                        <div class="form-group mb-3">
                            <label asp-for="StartTime" class="form-label fw-bold">Başlangıç Tarihi ve Saati</label>
                            <input asp-for="StartTime" type="datetime-local" class="form-control"
                                   value="@DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>

                        @* 3. الملاحظات *@
                        <div class="form-group mb-4">
                            <label asp-for="Notes" class="form-label fw-bold">Üye Notları (Opsiyonel)</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Eğitmene iletmek istediğiniz bir not var mı?"></textarea>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                <i class="bi bi-check-circle"></i> Randevuyu Kaydet
                            </button>
                            <a asp-action="MyAppointments" class="btn btn-link text-secondary">
                                <i class="bi bi-arrow-left"></i> Randevularıma Geri Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}