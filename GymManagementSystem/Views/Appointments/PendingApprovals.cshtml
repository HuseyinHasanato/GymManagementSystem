@model IEnumerable<GymManagementSystem.Models.Appointment>
@{
    ViewData["Title"] = "Onay Bekleyen Randevular";
}

<div class="container mt-4">
    <h2 class="text-center mb-4"><i class="bi bi-bell-fill text-warning"></i> Onay Bekleyen Randevu Talepleri</h2>
    <p class="text-center text-muted">Üyeler tarafından alınan randevuları buradan yönetebilirsiniz.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm mt-5">
            <div class="card-body text-center py-5">
                <i class="bi bi-calendar-check text-muted" style="font-size: 3rem;"></i>
                <h4 class="mt-3 text-secondary">Şu anda onay bekleyen yeni randevu talebi bulunmamaktadır.</h4>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th>Üye Bilgisi</th>
                        <th>Ders Adı</th>
                        <th>Başlangıç</th>
                        <th>Bitiş</th>
                        <th>Notlar</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@((item.Member != null ? item.Member.Email : "Bilinmiyor"))</strong>
                            </td>
                            <td><span class="badge bg-info text-dark">@(item.Class?.Name ?? "Genel")</span></td>
                            <td>@item.StartTime.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@item.EndTime.ToString("HH:mm")</td>
                            <td class="text-truncate" style="max-width: 150px;">
                                @(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)
                            </td>
                            <td class="text-center">
                                @* زر الموافقة *@
                                <form asp-action="Approve" asp-route-id="@item.AppointmentId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success px-3">
                                        Onayla
                                    </button>
                                </form>

                                @* زر الرفض *@
                                <form asp-action="Reject" asp-route-id="@item.AppointmentId" method="post" class="d-inline"
                                      onsubmit="return confirm('Bu randevuyu reddetmek istediğinizden emin misiniz?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1">
                                        Reddet
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}