@model GymManagementSystem.Models.Trainer

@{
    ViewData["Title"] = "Eğitmen Düzenle";
}

<h2 class="text-center mb-4">✍️ Eğitmen Bilgilerini Düzenle</h2>
<p class="text-center text-muted">Lütfen eğitmen @Model.FullName bilgilerini güncelleyin.</p>

<hr />
<div class="row justify-content-center">
    @* Formu ortalamak için düzenlendi *@
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" /> @* Eğitmen ID'si düzenleme için gizli olarak gönderilir *@

            <div class="form-group mb-3">
                <label asp-for="FullName" class="control-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Specialty" class="control-label"></label>
                <input asp-for="Specialty" class="form-control" />
                <span asp-validation-for="Specialty" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="ImageUrl" class="control-label"></label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
                <small class="form-text text-muted">Fotoğraf URL'sini buraya yapıştırın.</small>
            </div>

            <div class="form-group mt-4 text-center">
                <input type="submit" value="Güncelle & Kaydet" class="btn btn-warning btn-lg w-50" />
                <a asp-action="Index" class="btn btn-secondary mt-2 w-50">Listeye Geri Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}