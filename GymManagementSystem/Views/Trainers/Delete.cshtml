@model GymManagementSystem.Models.Trainer

@{
    ViewData["Title"] = "Eğitmen Silme Onayı";
}

<h2 class="text-center mb-4 text-danger">⚠️ Eğitmen Silme İşlemi</h2>

<div class="alert alert-danger text-center shadow-sm mx-auto" style="max-width: 600px;">
    <h4>**@Model.FullName** adlı eğitmeni silmek istediğinizden **EMİN MİSİNİZ**?</h4>
    <p>Bu işlem **geri alınamaz** ve eğitmenin randevu kayıtları etkilenebilir.</p>
</div>

<div class="card shadow-lg mx-auto mt-4" style="max-width: 600px;">
    <div class="card-body">

        <div class="text-center mb-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.FullName Resmi" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%;" />
            }
        </div>

        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.FullName)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.FullName)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Specialty)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Specialty)
            </dd>
        </dl>
    </div>

    <div class="card-footer text-center">
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Silme İşlemini ONAYLA" class="btn btn-danger btn-lg" />
            <a asp-action="Index" class="btn btn-secondary mt-2">Listeye Geri Dön</a>
        </form>
    </div>
</div>