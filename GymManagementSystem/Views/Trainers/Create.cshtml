@model GymManagementSystem.Models.Trainer

@{
    ViewData["Title"] = "Yeni Eğitmen Ekle";
}

<h2 class="text-center mb-4">🤸 Yeni Eğitmen Oluştur</h2>

<hr />
<div class="row justify-content-center">
    @* Formu ortalamak için justify-content-center ekledik *@
    <div class="col-md-6">
        @* Formu biraz daha genişlettik *@
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="FullName" class="control-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Specialty" class="control-label"></label>
                <input asp-for="Specialty" class="form-control" />
                <span asp-validation-for="Specialty" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="ImageUrl" class="control-label"></label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
                <small class="form-text text-muted">Eğitmenin fotoğrafının doğrudan URL'sini girin.</small>
            </div>

            <div class="form-group mt-4 text-center">
                <input type="submit" value="Eğitmeni Kaydet" class="btn btn-primary btn-lg w-50" />
                <a asp-action="Index" class="btn btn-secondary mt-2 w-50">Listeye Geri Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}