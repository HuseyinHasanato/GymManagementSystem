@model GymManagementSystem.Models.Trainer

@{
    ViewData["Title"] = "Yeni Eğitmen Ekle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="card-title mb-0"><i class="bi bi-person-plus"></i> Yeni Eğitmen Ekle</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Örn: Ahmet Yılmaz" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Specialty" class="form-label fw-bold"></label>
                            <input asp-for="Specialty" class="form-control" placeholder="Örn: Yoga, Pilates, Crossfit" />
                            <span asp-validation-for="Specialty" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                                <input asp-for="ImageUrl" class="form-control" id="imageUrlInput" placeholder="https://example.com/photo.jpg" />
                            </div>
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                            <div class="mt-3 text-center">
                                <p class="text-muted small">Fotoğraf Önizleme:</p>
                                <img id="imgPreview" src="https://via.placeholder.com/150" alt="Önizleme" class="img-thumbnail shadow-sm" style="width: 150px; height: 150px; object-fit: cover;" />
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">İptal</a>
                            <button type="submit" class="btn btn-success px-5">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <script>
        // رابط الصورة المباشر لتحديث المعاينة
        document.getElementById('imageUrlInput').addEventListener('input', function () {
            const preview = document.getElementById('imgPreview');
            const url = this.value;
            if (url) {
                preview.src = url;
            } else {
                preview.src = 'https://via.placeholder.com/150';
            }
        });

        // التعامل مع أخطاء تحميل الصورة
        document.getElementById('imgPreview').onerror = function() {
            this.src = 'https://via.placeholder.com/150?text=Geçersiz+URL';
        };
    </script>
}