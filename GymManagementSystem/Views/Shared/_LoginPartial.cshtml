@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        @* Kullanıcı Giriş Yapmışsa *@

        <li class="nav-item">
            @* "Merhaba, Kullanıcı Adı!" bağlantısı. Hesap Yönetimi sayfasına (Manage) gider. *@
            <a class="nav-link text-warning" asp-area="Identity" asp-page="/Account/Manage/Index" title="Hesabı Yönet">
                <i class="fas fa-user-circle"></i> Merhaba @User.Identity?.Name!
            </a>
        </li>
        <li class="nav-item">
            @* Çıkış (Logout) formu ve butonu *@
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-white">
                    <i class="fas fa-sign-out-alt"></i> Çıkış Yap
                </button>
            </form>
        </li>
    }
    else
    {
        @* Kullanıcı Giriş Yapmamışsa *@

        <li class="nav-item">
            @* Kayıt Ol (Register) bağlantısı *@
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Register">
                <i class="fas fa-user-plus"></i> Kayıt Ol
            </a>
        </li>
        <li class="nav-item">
            @* Giriş Yap (Login) bağlantısı *@
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login">
                <i class="fas fa-sign-in-alt"></i> Giriş Yap
            </a>
        </li>
    }
</ul>