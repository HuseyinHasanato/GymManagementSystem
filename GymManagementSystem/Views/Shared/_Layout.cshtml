@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IAuthorizationService AuthorizationService

<!DOCTYPE html>
<html lang="tr" dir="ltr">
@* Dil ve yön ayarı *@
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Spor Salonu Yönetim Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Font Awesome ikon kütüphanesi eklendi *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        {{-- Navbar tasarımı güncellendi (Örn: navbar-dark bg-dark) --}}
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-warning" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-dumbbell"></i> Spor Salonu YS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Navigasyonu Aç/Kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Anasayfa</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="GroupClasses" asp-action="Index">Ders Kataloğu</a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            // YÖNETİCİ BAĞLANTILARI
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-warning" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-tools"></i> Yönetici Paneli
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Trainers" asp-action="Index">🏋️ Eğitmen Yönetimi</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="GroupClasses" asp-action="Index">🤸 Sınıf Yönetimi</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Appointments" asp-action="PendingApprovals">🔔 Randevu Onayları</a></li>
                                    </ul>
                                </li>
                            }

                            // ÜYE BAĞLANTILARI
                            @if (User.IsInRole("Member"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="" asp-controller="Appointments" asp-action="Book"><i class="fas fa-calendar-plus"></i> Randevu Al</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="" asp-controller="Appointments" asp-action="MyAppointments"><i class="fas fa-list-alt"></i> Randevularım</a>
                                </li>
                            }

                            // YAPAY ZEKA BAĞLANTISI (Tüm Giriş Yapanlar İçin)
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="AI" asp-action="Profile">
                                    <i class="fas fa-robot"></i> Yapay Zeka Önerileri
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" /> @* Giriş/Kayıt/Çıkış linkleri için *@
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light">
        @* Footer rengi değiştirildi *@
        <div class="container">
            &copy; @DateTime.Now.Year - Spor Salonu Yönetim Sistemi - <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik Politikası</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>