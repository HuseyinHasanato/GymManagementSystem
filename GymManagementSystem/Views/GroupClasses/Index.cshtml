@model IEnumerable<GymManagementSystem.Models.GroupClass>

@{
    ViewData["Title"] = "Grup Dersleri Kataloğu";
}

<h2 class="text-center mb-4">🤸 Grup Dersleri ve Hizmetler</h2>
<p class="text-center text-muted">Mevcut tüm derslerimize göz atın ve randevu almak için Randevu Al butonunu kullanın.</p>

@if (User.IsInRole("Admin"))
{
    <p class="text-end">
        <a asp-action="Create" class="btn btn-primary btn-lg"><i class="fas fa-plus-circle"></i> Yeni Ders Ekle</a>
    </p>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3" role="alert">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover mt-4">
        <thead class="bg-dark text-white">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>@Html.DisplayNameFor(model => model.StartTime)</th>
                <th>@Html.DisplayNameFor(model => model.DurationMinutes)</th>
                <th>@Html.DisplayNameFor(model => model.MaxCapacity)</th>
                <th>@Html.DisplayNameFor(model => model.Trainer)</th>
                <th>Aksiyonlar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@item.StartTime.ToString("dd MMM, HH:mm")</td>
                    <td>@item.DurationMinutes dakika</td>
                    <td>@Html.DisplayFor(modelItem => item.MaxCapacity)</td>
                    <td>@(item.Trainer?.FullName ?? "Atanmadı")</td>
                    <td>
                        @* 1. Detaylar Butonu (Herkes İçin) *@
                        <a asp-action="Details" asp-route-id="@item.GroupClassId" class="btn btn-sm btn-info" title="Detayları Gör">
                            <i class="fas fa-info-circle"></i>
                        </a>

                        @* 2. Yönetici Butonları (Admin Rolü İçin) *@
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.GroupClassId" class="btn btn-sm btn-warning" title="Düzenle">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.GroupClassId" class="btn btn-sm btn-danger" title="Sil">
                                <i class="fas fa-trash"></i>
                            </a>
                        }

                        @* 3. Üye Randevu Butonu (Giriş Yapan Üye İçin) *@
                        @if (User.Identity!.IsAuthenticated && !User.IsInRole("Admin"))
                        {
                            <a asp-controller="Appointments" asp-action="Book" class="btn btn-sm btn-success" title="Randevu Al">
                                <i class="fas fa-calendar-alt"></i> Randevu Al
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>